RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Receives an email for each new Booking, Booker cancellation, capacity refund, and refund failure.
OPERATOR_EMAIL=
APP_ORIGIN=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
# Shared secret the app server passes to every public Convex function.
# Set the same value on the Convex deployment: npx convex env set CONVEX_SERVER_SECRET <value>
CONVEX_SERVER_SECRET=
# Operator sign-in also needs JWT_PRIVATE_KEY, JWKS, SITE_URL, OPERATOR_ALLOWED_EMAILS,
# RESEND_API_KEY, and RESEND_FROM_EMAIL set on the Convex deployment. See README.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_ENV=sandbox
